MONGODB_URI=
POSTGRES_DATABASE_URL=
JWT_SECRET=
PORT=
# Optional – enables live Gemini LLM Insight in the productivity agent.
# Without it the agent returns a deterministic fallback insight.
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# File Upload Storage
UPLOAD_DIR=./uploads

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300

# Background Maintenance Cron Jobs
CLEANUP_CRON_SCHEDULE="0 * * * *"
ORPHANED_FILE_MAX_AGE_HOURS=24

# Payment Gateway (Razorpay Sandbox / Test Mode)
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=rzp_test_mock_secret

